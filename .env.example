# ==========================================
# CẤU HÌNH BOT TELEGRAM ĐIỀU KHIỂN & LÀM VIỆC NHÓM
# ==========================================
# Token bot lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Danh sách ID Telegram cá nhân được phép truy cập (dạng USER_ID:ROLE)
ALLOWED_TELEGRAM_USERS="123456789:admin,987654321:creator"

# ID của Nhóm Chat Telegram (Group Workspace) nơi cả nhóm cùng làm việc chung
# Lấy ID nhóm bằng cách thêm bot @userinfobot hoặc @RawDataBot vào nhóm
ALLOWED_TELEGRAM_GROUPS="-1001234567890"

# ==========================================
# CỤM TÀI KHOẢN GOOGLE ULTRA & AI SERVICES
# ==========================================
# Danh sách Gemini API Keys từ các tài khoản Google Ultra để tự động xoay vòng (chống nghẽn/hết quota)
# Phân cách bởi dấu phẩy
GEMINI_API_KEYS="key_tai_khoan_ultra_1,key_tai_khoan_ultra_2,key_tai_khoan_ultra_3"

# Lấy miễn phí tại: https://www.pexels.com/api/
# Hỗ trợ 1 key (PEXELS_API_KEY) hoặc nhiều key xoay vòng (PEXELS_API_KEYS="key1,key2")
PEXELS_API_KEY="your_pexels_api_key_here"

# Pixabay API (Tùy chọn - Kho B-Roll 3D, CGI và animation trừu tượng, miễn phí tại https://pixabay.com/api/docs/)
PIXABAY_API_KEY=""

# Hugging Face Access Token (Tùy chọn - Sinh ảnh siêu thực FLUX.1 không watermark & Video AI Cloud, miễn phí tại https://huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=""

# ==========================================
# CẤU HÌNH SẢN XUẤT NỘI DUNG MẶC ĐỊNH
# ==========================================
# Ngôn ngữ mục tiêu: 'en' (Tiếng Anh - Khuyên dùng) hoặc 'vi' (Tiếng Việt)
DEFAULT_TARGET_LANGUAGE="en"

# Giọng đọc mặc định của Edge-TTS
DEFAULT_TTS_VOICE="en-US-ChristopherNeural"

# ==========================================
# CƠ SỞ DỮ LIỆU & LƯU TRỮ
# ==========================================
DATABASE_URL="sqlite:///./storage/ai_youtube.db"

# ==========================================
# COLAB GPU RENDER FARM (TÙY CHỌN - TĂNG TỐC 20S/VIDEO)
# ==========================================
# Lấy từ file colab_gpu_worker.ipynb khi chạy trên Google Colab Pro+
COLAB_WORKER_URL=""
# Chế độ render: 'auto' (ưu tiên Colab GPU, tự động chuyển Local nếu Colab tắt) hoặc 'local'
RENDER_BACKEND="auto"

# ==========================================
# PHẦN CỨNG & TĂNG TỐC RENDER GPU (HARDWARE ACCELERATION)
# ==========================================
# Tự động phát hiện GPU (NVIDIA NVENC, Windows Media Foundation, Intel QuickSync, Apple M-series)
# Giúp tăng tốc render video nhanh gấp 3x - 10x so với thuần CPU.
ENABLE_GPU_ACCELERATION="true"
# Chỉ định ép buộc bộ mã hóa nếu muốn (để trống "" để hệ thống tự động dò tìm thông minh nhất):
# Các lựa chọn: "h264_nvenc" (NVIDIA), "h264_mf" (Windows GPU), "h264_qsv" (Intel GPU), "libx264" (CPU)
FORCE_GPU_ENCODER=""

# ==========================================
# CẤU HÌNH TỰ ĐỘNG HÓA AUTO-PILOT & NHẮC HẸN KÊNH
# ==========================================
# Danh sách ID kênh được chỉ định bật Auto-Pilot hàng loạt (phân cách bởi dấu phẩy).
# Để trống ("") nếu muốn áp dụng cho TẤT CẢ các kênh.
# Ví dụ: AUTOPILOT_ENABLED_CHANNELS="ch_paws_hearts_rescue,channel_maya"
AUTOPILOT_ENABLED_CHANNELS=""

