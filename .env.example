# ==========================================
# CẤU HÌNH BOT TELEGRAM ĐIỀU KHIỂN ĐA NGƯỜI DÙNG
# ==========================================
# Token bot lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Danh sách ID Telegram được phép truy cập hệ thống (phân quyền)
# Cú pháp: USER_ID:ROLE (ROLE có thể là admin hoặc creator)
# Ví dụ: 123456789:admin,987654321:creator
ALLOWED_TELEGRAM_USERS="123456789:admin,987654321:creator"

# ==========================================
# CẤU HÌNH AI & DỊCH VỤ TRUYỀN THÔNG
# ==========================================
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Lấy miễn phí tại: https://www.pexels.com/api/
PEXELS_API_KEY="your_pexels_api_key_here"

# ==========================================
# CẤU HÌNH SẢN XUẤT NỘI DUNG MẶC ĐỊNH
# ==========================================
# Ngôn ngữ mục tiêu: 'en' (Tiếng Anh - Khuyên dùng) hoặc 'vi' (Tiếng Việt)
DEFAULT_TARGET_LANGUAGE="en"

# Giọng đọc mặc định của Edge-TTS
# Tiếng Anh nam trầm: en-US-ChristopherNeural hoặc en-US-GuyNeural
# Tiếng Anh nữ: en-US-AriaNeural
# Tiếng Việt nữ: vi-VN-HoaiMyNeural | Tiếng Việt nam: vi-VN-NamMinhNeural
DEFAULT_TTS_VOICE="en-US-ChristopherNeural"

# ==========================================
# CƠ SỞ DỮ LIỆU & LƯU TRỮ
# ==========================================
DATABASE_URL="sqlite:///./storage/ai_youtube.db"
